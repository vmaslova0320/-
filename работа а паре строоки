#include <stdio.h>
int main(){
char str [100];
	int count=0;
	printf("введите строку");
scanf("%s",str);
	for(int i=0; str[i] !='\0';i=i+1){
		char c = str[i];
		if(c=='a' || c=='e' || c=='i' || c=='o' || c=='u'|| c=='A'|| c=='E' || c=='I'|| c=='O'|| c=='U'){
			count=count+1;
		}
	}
printf("%d\n", count);
	return 0;
}


