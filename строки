/* (посчитать слова )

#include <stdio.h>
#include <string.h>

int main(void) {
    char buf[200];
    fgets(buf, sizeof(buf), stdin);
    buf[strcspn(buf, "\n")] = '\0';

    int count = 0;
    for (char *w = strtok(buf, " "); w; w = strtok(NULL, " "))
        count++;

    printf("%d\n", count);
    return 0;
}
